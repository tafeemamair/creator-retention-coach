# ==============================================================================
# Creator Retention Coach — Standalone MCP Server Environment Configuration
# Safe Template / Example Configuration — DO NOT COMMIT REAL PRODUCTION SECRETS
# ==============================================================================

# Server Network Configuration (Public / Config)
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Public Endpoints & Canonical Identity (Public / Config)
MCP_RESOURCE_URL=https://mcp.creatorretentioncoach.in
MCP_AUDIENCE=https://mcp.creatorretentioncoach.in

# Supabase Auth Configuration (Public / Config & Secret)
SUPABASE_AUTH_ISSUER=https://<your-project-ref>.supabase.co/auth/v1
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
# Optional secret for HS256 verification fallback:
# SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# OpenAI / ChatGPT Integration (Secret & Config)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_APPS_CHALLENGE_TOKEN=crc_openai_apps_challenge_verified_token

# Upstash Redis Credit Ledger (Public / Config & Secret)
UPSTASH_REDIS_REST_URL=https://<your-upstash-redis-endpoint>.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
